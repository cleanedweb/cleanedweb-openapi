{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cleanedweb/cleanedweb-openapi/tests/case.schema.json",
  "title": "CleanedWeb SDK conformance file",
  "type": "object",
  "required": ["group", "cases"],
  "additionalProperties": false,
  "properties": {
    "group": {"type": "string"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "title", "operation", "client", "args", "exchanges", "expect"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "title": {"type": "string"},
        "spec_note": {"type": "string"},
        "operation": {
          "enum": [
            "catalog.run", "catalog.result",
            "runs.get", "runs.items", "runs.result", "runs.abort", "runs.list", "runs.iter",
            "sources.run", "sources.start", "sources.stream", "sources.get_run", "sources.get_run_result",
            "sources.versions", "sources.version_contract", "sources.connection", "sources.health",
            "schedules.create", "schedules.list", "schedules.get", "schedules.pause", "schedules.resume", "schedules.delete"
          ]
        },
        "client": {
          "type": "object",
          "required": ["api_key", "max_retries", "max_retry_delay_seconds"],
          "additionalProperties": false,
          "properties": {
            "api_key": {"type": ["string", "null"]},
            "max_retries": {"type": "integer", "minimum": 0},
            "max_retry_delay_seconds": {"type": "number", "minimum": 0}
          }
        },
        "args": {"type": "object"},
        "exchanges": {"type": "array", "items": {"$ref": "#/$defs/exchange"}},
        "expect": {"$ref": "#/$defs/expect"}
      }
    },
    "exchange": {
      "type": "object",
      "required": ["request"],
      "additionalProperties": false,
      "properties": {
        "request": {
          "type": "object",
          "required": ["method", "path"],
          "additionalProperties": false,
          "properties": {
            "method": {"enum": ["GET", "POST", "DELETE"]},
            "path": {"type": "string", "pattern": "^/"},
            "query": {"type": "object", "additionalProperties": {"type": "string"}},
            "headers": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
            "body": {}
          }
        },
        "response": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": {"type": "integer", "minimum": 200, "maximum": 599},
            "headers": {"type": "object", "additionalProperties": {"type": "string"}},
            "json": {},
            "text": {"type": "string"}
          }
        },
        "network_error": {"enum": ["connection_reset", "timeout", "dns"]},
        "spec_invalid_request": {"type": "boolean", "description": "The request body is deliberately outside the spec, to provoke a server-side refusal."}
      },
      "oneOf": [{"required": ["response"]}, {"required": ["network_error"]}]
    },
    "expect": {
      "type": "object",
      "required": ["sleeps"],
      "additionalProperties": false,
      "properties": {
        "sleeps": {"type": "array", "items": {"type": "number"}},
        "generated_key": {"type": "boolean"},
        "result": {"type": "object"},
        "run": {"type": "object"},
        "items": {"type": "array"},
        "run_ids": {"type": "array", "items": {"type": "string"}},
        "schedule": {"type": "object"},
        "schedules": {"type": "array"},
        "limit": {"type": "integer"},
        "data": {"type": "object"},
        "events": {"type": "array"},
        "deleted": {"type": "object"},
        "error": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": [
                "missing_api_key", "invalid_argument", "connection", "authentication", "permission_denied",
                "not_found", "version_not_found", "insufficient_credit", "usage_budget_exceeded",
                "idempotency_conflict", "version_conflict", "invalid_request", "rate_limited", "server",
                "redirect", "api_status"
              ]
            }
          }
        }
      },
      "oneOf": [
        {"required": ["result"]}, {"required": ["run"]}, {"required": ["items"]}, {"required": ["run_ids"]},
        {"required": ["schedule"]}, {"required": ["schedules"]}, {"required": ["data"]}, {"required": ["events"]}, {"required": ["deleted"]}, {"required": ["error"]}
      ]
    }
  }
}
