    {
      "id": "failed_run_marker_on_run",
      "title": "An error with error_code run_failed is a failed run: final for the key, not retried even on a retryable status",
      "operation": "catalog.run",
      "client": {
        "api_key": "cw_test_key",
        "max_retries": 2,
        "max_retry_delay_seconds": 30
      },
      "args": {
        "api_id": "generated_047a8ebb25911ccf62f4a212",
        "endpoint_id": "generated_047a8ebb25911ccf62f4a212_search",
        "input": {},
        "idempotency_key": "test-key-1"
      },
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "path": "/v1/catalog/public/apis/generated_047a8ebb25911ccf62f4a212/endpoints/generated_047a8ebb25911ccf62f4a212_search/run",
            "headers": {
              "Authorization": "Bearer cw_test_key",
              "Idempotency-Key": "$key",
              "Content-Type": "application/json"
            },
            "body": {
              "input": {}
            }
          },
          "response": {
            "status": 502,
            "headers": {
              "Location": "/v1/runs/0123456789abcdef0123456789abcdef"
            },
            "json": {
              "detail": {
                "code": "source_blocked",
                "message": "The source refused access.",
                "run_id": "0123456789abcdef0123456789abcdef",
                "error_code": "run_failed",
                "replayed": false
              }
            }
          }
        }
      ],
      "expect": {
        "error": {
          "kind": "server",
          "status_code": 502,
          "code": "source_blocked",
          "run_failed": true,
          "replayed": false,
          "unsure": false,
          "run_id": "0123456789abcdef0123456789abcdef",
          "error_code": "run_failed"
        },
        "sleeps": []
      }
    },
